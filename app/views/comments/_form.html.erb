<%= form_with model: [article, comment] do |f| %>
  <div class="mb-3">
    <%= f.hidden_field :article_id %>
    <%= f.hidden_field :response_id %>
    <%= f.hidden_field :status, value: "public" %>
    <%= f.text_area :body, cols: 100, rows: 2, data: { action: "keydown.enter->comment#submit" }, class: "form-control", placeholder: "Write your opinion here" %>
  </div>
<% end %>
