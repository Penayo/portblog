<div class="card w-100 borderless">
  <div class="card-body">

    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">Creating Account</h5>
    </div>

    <%= form_with(model: @account, url: accounts_path, local: true, id: "account") do |f| %>

      <!-- Display error message of form -->
      <% if f.object.errors.full_messages.any? %>
        <div class="alert alert-danger" role="alert">
          <% f.object.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </div>
      <% end %>

      <div class="mt-2">
        <%= f.label :name, class: "form-label" %>
        <%= f.text_field :name, class: "form-control" %>
      </div>

      <!-- Field of registration form -->
      <div class='mt-2'>
        <%= f.label :email, class: "form-label" %>
        <%= f.text_field :email, class: "form-control", placeholder: 'Please enter email' %>
      </div>

      <div class='mt-2'>
        <%= f.label :password, class: "form-label" %>
        <%= f.password_field :password, class: "form-control", placeholder: 'Please enter password' %>
      </div>

      <div class='mt-2'>
        <%= f.label :password_confirmation, class: "form-label" %>
        <%= f.password_field :password_confirmation, class: "form-control", placeholder: 'Please enter password confirmation' %>
      </div>

      <div class='mt-2'>
        <%= f.submit 'Sign Up', class: "btn btn-primary" %>
      </div>
    <% end%>
  </div>
</div>
