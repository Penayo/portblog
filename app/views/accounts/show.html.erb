<%= page_title title: "Author Details" do %>
  <div class="btn-group" role="group" aria-label="Basic outlined example">
    <%= link_to 'Back', accounts_path, class: "btn btn-primary" %>
    <%= link_to 'Edit Profile', edit_account_path(@account), class: "btn btn-primary" %>
  </div>
<% end %>

<div class="container">
  <div class="row">
    <div class="col-lg-8">
      <section id="blog-details" class="blog-details section">
        <div class="container">
          <h3><%= @account.full_name %></h3>
          <h6><%= @account.headline %></h6>        

          <div class="mt-3">
            <h5>About me</h5>
            <%= @account.about %>
          </div>

          <div class="mt-3">
            <h5>Email</h5>
            <%= @account.email %>            
          </div>
        </div>
      </section>
    </div>

    <div class="col-lg-4 sidebar">
      <div class="widgets-container">
        <%= render "articles/recent_posts" %>
      </div>
    </div>
  </div>
</div>
