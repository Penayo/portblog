<div class="card w-100 borderless">
  <div class="card-body">

    <div class="pt-4 pb-2">
      <h5 class="card-title text-center pb-0 fs-4">Create and account</h5>
    </div>

    <%= form_with(model: @account, id: "account") do |f| %>

      <!-- Display error message of form -->
      <% if f.object.errors.full_messages.any? %>
        <div class="alert alert-danger" role="alert">
          <% f.object.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </div>
      <% end %>

      <div class="mb-3">
        <%= f.label :profile_img, class: "form-label" %>
        <%= f.file_field :profile_img, class: "form-control" %>
      </div>

      <div class="mb-2">
        <%= f.label :headline, class: "form-label" %>
        <%= f.text_field :headline, class: "form-control" %>
      </div>

      <div class="mt-2">
        <%= f.label :first_name, class: "form-label" %>
        <%= f.text_field :first_name, class: "form-control" %>
      </div>

      <div class="mb-4 mt-2">
        <%= f.label :last_name, class: "form-label" %>
        <%= f.text_field :last_name, class: "form-control" %>
      </div>

      <div class='mt-2'>
        <%= f.submit class: "btn btn-primary" %>
      </div>
    <% end%>
  </div>
</div>
