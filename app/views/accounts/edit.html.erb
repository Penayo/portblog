<%= page_title title: "Editing Profile" do %>
  <div class="btn-group" role="group" aria-label="Basic outlined example">
    <%= link_to 'Back', account_path(@account), class: "btn btn-primary" %>
  </div>
<% end %>


<div class="container">
  <div class="row">
    <div class="col-lg-8">
      <section id="blog-details" class="blog-details section">
        <%= form_with(model: @account, id: "account") do |f| %>

          <!-- Display error message of form -->
          <% if f.object.errors.full_messages.any? %>
            <div class="alert alert-danger" role="alert">
              <% f.object.errors.full_messages.each do |msg| %>
                <li><%= msg %></li>
              <% end %>
            </div>
          <% end %>

          <div class="mb-4 mt-2">
            <%= f.label :name, class: "form-label" %>
            <%= f.text_field :name, class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :profile_img, class: "form-label" %>
            <%= f.file_field :profile_img, class: "form-control" %>
          </div>

          <div class="mb-2">
            <%= f.label :headline, class: "form-label" %>
            <%= f.text_field :headline, class: "form-control" %>
          </div>

          <div class="mb-2">
            <%= f.label :about, class: "form-label" %>
            <%= f.text_area :about, class: "form-control" %>
          </div>

          <div class='mt-2'>
            <%= f.submit class: "btn btn-primary" %>
          </div>
        <% end%>
      </section>
    </div>


    <div class="col-lg-4 sidebar">
      <div class="widgets-container">
        <%= render "articles/recent_posts" %>
      </div>
    </div>
  </div>
</div>
